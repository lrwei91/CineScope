# TMDB API Key - 用于获取更完整的影视元数据
# 获取方式：访问 https://www.themoviedb.org/settings/api
# 创建账户并申请 API Key（v3 auth）
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 将你的 API Key 填入下方
# 3. source .env 后通过统一入口运行数据任务，不要直接调用生成器：
#    python3 scripts/automation/run_update.py --task full --dry-run
#
# 完整环境变量与可调参数见 docs/DATA_UPDATE_GUIDE.md

TMDB_API_KEY=your_api_key_here

# 猫眼实时票房接口地址 - 默认使用 60s API 的实时猫眼票房接口
# 如需私有部署 60s，可覆盖为自己的实例地址
MAOYAN_BOX_OFFICE_API_URL=https://60s.viki.moe/v2/maoyan/realtime/movie

# 豆瓣详情缓存天数（默认 14 天）
# DOUBAN_SUBJECT_CACHE_TTL_DAYS=14

# 豆瓣搜索缓存天数（默认 30 天）
# DOUBAN_SEARCH_CACHE_TTL_DAYS=30

# 跳过海报下载（默认 false）
# SKIP_POSTER_DOWNLOADS=false
